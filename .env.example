# Stellar network configuration — Testnet only. This project never targets Mainnet.
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# Anchor used for D1 (asset issuer + trustline source). See docs/architecture.md.
ANCHOR_DOMAIN=testanchor.stellar.org

# Public keys (G...) only. NEVER put a secret key (S...) in a committed file.
# Populate by running: stellar keys generate <name> --network testnet --fund
# for each of: admin, registrar, acuris, partner. See docs/runbook.md.
ACURIS_PUBLIC_KEY=
PARTNER_PUBLIC_KEY=
REGISTRAR_PUBLIC_KEY=
ADMIN_PUBLIC_KEY=

# Local `stellar` CLI identity names (aliases, not keys) backing the public keys above —
# defaults to these names, override only if you generated your identities under different ones.
STELLAR_ADMIN_IDENTITY=admin
STELLAR_REGISTRAR_IDENTITY=registrar

# Deployed contract id (C...), filled in after `stellar contract deploy`. See docs/runbook.md.
PROVENANCE_CONTRACT_ID=
